APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# RPG 单点登录：服务端密钥必须与 rpg-api 一致，票据默认 60 秒且只能使用一次。
RPG_SSO_CLIENT_SECRET=
RPG_SSO_CALLBACK_URL=https://rpg.dogeow.com/auth/callback
RPG_SSO_RETURN_ORIGINS=https://rpg.dogeow.com,http://localhost:3001,http://127.0.0.1:3001
# 游戏中心单点登录：服务端密钥必须与 game-api 一致。
GAME_SSO_CLIENT_SECRET=
GAME_SSO_CALLBACK_URL=https://game.dogeow.com/auth/callback
GAME_SSO_RETURN_ORIGINS=https://game.dogeow.com,http://localhost:3002,http://127.0.0.1:3002

REPO_WATCH_SSO_CLIENT_SECRET=
REPO_WATCH_SSO_CALLBACK_URL=https://repo-watch.dogeow.com/auth/callback
REPO_WATCH_SSO_RETURN_ORIGINS=https://repo-watch.dogeow.com,http://localhost:3012,http://127.0.0.1:3012
SSO_TICKET_LIFETIME_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 知识库 AI
KNOWLEDGE_BUILD_INDEX_URL=http://localhost:3000/api/knowledge/build-index

# 又拍云（用于 Ollama 生成图片等文件上传）
UPYUN_BUCKET=your-bucket
UPYUN_OPERATOR=your-operator
UPYUN_PASSWORD=your-operator-password
UPYUN_DOMAIN=https://your-cdn.b0.upaiyun.com
UPYUN_API_HOST=v0.api.upyun.com
UPYUN_CDN_URL=

# Sentry 错误追踪
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=true
SENTRY_TRACES_SAMPLE_RATE=


# Web Push（运行 php artisan webpush:vapid 生成 VAPID 密钥）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Safari/iOS 需设置 VAPID_SUBJECT，为站点 URL 或 mailto: 地址
VAPID_SUBJECT=https://your-domain.com

# 部署完成后发送站内通知 / Web Push 的用户 ID（逗号分隔，如 1,2）
DEPLOY_NOTIFY_USER_IDS=1

# 网站状态页 /about/site：Hermes（OpenClaw Gateway，本机）
HERMES_HOST=127.0.0.1
HERMES_PORT=18789
HERMES_HEALTH_PATH=/health
HERMES_PROBE_PATTERN="openclaw gateway"
HERMES_CLI_BINARY=openclaw

#Supervisor 进程探针（用于 Reverb 与队列状态）
SUPERVISOR_REVERB_PROGRAM=reverb
SUPERVISOR_QUEUE_PROGRAM=queue-default
SUPERVISOR_REVERB_PROBE_PATTERN="artisan reverb:start"
SUPERVISOR_QUEUE_PROBE_PATTERN="artisan queue:(work|listen)"

# 去背景服务（simple-rmbg）
RMBG_API_URL=https://rmbg.dogeow.com/api/remove-bg
RMBG_TIMEOUT=120

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
